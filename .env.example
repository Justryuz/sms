# Supabase (kosongkan untuk guna data contoh / mod demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server sahaja. Jangan dedahkan kepada pelayar.
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive: folder "Agri Data Platform"
GOOGLE_DRIVE_FOLDER_ID=1wXNm0nG7dUOvNWkepN9ev3BcgwFZEn8M
# Pilihan A: service account (JSON satu baris dalam tanda petik tunggal, atau base64).
# Kongsi folder Drive dengan emel client_email service account (Viewer).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Pilihan B: API key (hanya untuk folder yang dikongsi "Anyone with the link").
GOOGLE_API_KEY=

# Rahsia untuk segerak harian (GET /api/sync-drive). Vercel Cron menghantarnya sebagai Bearer token.
CRON_SECRET=

# Log masuk dashboard (kata laluan min 8 aksara, AUTH_SECRET rawak min 16 aksara)
DASHBOARD_PASSWORD=
AUTH_SECRET=

# AI gateway serasi OpenAI (cth. LiteLLM) untuk pengelasan sentimen. Kosongkan untuk guna pengelas kata kunci.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# none | low | medium | high (lalai: low)
LLM_REASONING_EFFORT=low
